# Leave the keys empty to run fully offline: mock PayPal rail + scripted AI.
PAYPAL_MODE=mock            # mock | sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
AI_MODE=mock                # mock | anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_SMART=claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
CHANNEL3_API_KEY=
# On Render, leave APP_BASE_URL empty and the app uses RENDER_EXTERNAL_URL, which Render sets.
APP_BASE_URL=http://localhost:3000
DATA_DIR=./data
# Sandbox only: real sandbox seller email that replaces the fictional sellers in Second Look samples
SECOND_LOOK_SELLER_EMAIL=
# Sandbox only: personal sandbox account that receives Shop helper-agent payouts
SHOP_HELPER_EMAIL=
# Sandbox only: JSON map of npm maintainer handle -> sandbox receiver email for Cash Weather upstream payouts
CASH_WEATHER_RECEIVERS_JSON=
# Sandbox only: comma-separated sandbox emails for Toll Road publishers
TOLL_ROAD_PUBLISHER_EMAILS=
# Optional: override the PayPal REST base URL (defaults to https://api-m.sandbox.paypal.com)
PAYPAL_API_BASE=
# Sandbox only: Cash Weather reads npm maintainers live from registry.npmjs.org. Set to 0 to keep the npm registry offline (bundled fixtures).
CASH_WEATHER_NPM_LIVE=
# Optional: milliseconds between Toll Road fetches in mock mode, so the page can animate them (default 400; 0 turns it off)
TOLL_ROAD_MOCK_DELAY_MS=
# Optional: turns on POST /api/p/bounty/tick (bearer token). Leave empty to keep the route off; the Render cron job sends it.
CRON_SECRET=
# Optional: turns on the owner-only /api/affiliates routes that the /affiliates page uses (bearer token). Leave empty to keep them off (404).
# AFFILIATE_ADMIN_SECRET=
